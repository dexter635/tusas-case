# Core
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_GPU=25

# Embedding & Reranker
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking & Retrieval
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=10
HYBRID_TOP_K=30

# LLM generation
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=2048
LLM_NUM_PREDICT=512

# OCR (GPU-first)
OCR_BACKEND=tesseract
OCR_GPU=true
OCR_LANGS=tr,en

# Paths (relative to project root)
DATA_DIR=data
CHROMA_DIR=chroma_db
LOG_DIR=logs

# App
APP_NAME=TUSAŞ Belge Analiz Sistemi
APP_VERSION=1.0.0
DEBUG=false
